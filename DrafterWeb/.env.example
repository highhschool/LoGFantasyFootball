# Season whose rankings to load; also selects the mounted directory.
SEASON=2026

# Named-tunnel token from the Cloudflare Zero Trust dashboard.
# Leave unset to develop with a quick tunnel instead (see README).
TUNNEL_TOKEN=

# The browser calls the API from this origin once the tunnel is live.
CORS_ORIGINS=https://ngfldrafter.com,http://localhost:8000,http://localhost:5173

# Optional: auto-discovers the draft in P2.
SLEEPER_LEAGUE_ID=1261437958930563072

LOG_LEVEL=INFO

# Gates POST /api/rankings/reload. Unset = endpoint disabled (fails closed).
ADMIN_TOKEN=
