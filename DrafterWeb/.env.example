# Season whose rankings to load; also selects the mounted directory.
SEASON=2026

# Named-tunnel token from the Cloudflare Zero Trust dashboard.
# Leave unset to develop with a quick tunnel instead (see README).
TUNNEL_TOKEN=

# The browser calls the API from this origin once the tunnel is live.
CORS_ORIGINS=https://ngfldrafter.com,http://localhost:8000,http://localhost:5173

# The current season's league. A new one is created each year and the
# membership changes with it, so this has to be updated annually --
# 1261437958930563072 was 2025.
SLEEPER_LEAGUE_ID=1389704316960382976

LOG_LEVEL=INFO

# Gates POST /api/rankings/reload. Unset = endpoint disabled (fails closed).
ADMIN_TOKEN=

# Verified addresses Cloudflare Access may admit to /admin. Unset = no admin.
ADMIN_EMAILS=

# When keeper selections lock. Needs an explicit UTC offset —
# -05:00 is US Central in August (CDT), -06:00 in winter (CST).
KEEPER_DEADLINE=

# The contracts slate. Trading opens, then closes at the draft's start time --
# a single hard close rather than per-market ones, so nothing is ever tradeable
# once its answer is knowable. Season-specific: both need setting each year.
CONTRACTS_OPEN=
CONTRACTS_CLOSE=
